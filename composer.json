{
  "name": "takielias/codeigniter4-websocket",
  "description": "Websocket using Ratchet Websocket technology for CodeIgniter 4",
  "keywords": [
    "codeigniter",
    "codeigniter4",
    "php7",
    "php8",
    "php-library",
    "codeigniter websocket",
    "websocket",
    "realtime",
    "Ratchet"
  ],
  "homepage": "https://github.com/takielias/codeigniter4-websocket",
  "license": "MIT",
  "authors": [
    {
      "name": "Taki Elias",
      "email": "taki.elias@gmail.com",
      "homepage": "https://ebuz.xyz",
      "role": "Software Engineer"
    }
  ],
  "require": {
    "php": "^8.0|^8.1|^8.2|^8.3|^8.4",
    "cboden/ratchet": "^0.4.4",
    "phrity/websocket": "^3.7.3"
  },
  "require-dev": {
    "codeigniter4/framework": "^4",
    "phpunit/phpunit": "^9.0",
    "symfony/http-foundation": "^6.0|^7.0|^8.0",
    "symfony/routing": "^6.0|^7.0|^8.0"
  },
  "autoload": {
    "psr-4": {
      "Takielias\\CodeigniterWebsocket\\": "src"
    }
  },
  "scripts": {
    "post-update-cmd": [
      "composer dump-autoload",
      "php spark migrate:latest -n all"
    ]
  }
}
